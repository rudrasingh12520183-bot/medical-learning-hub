rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'admin@medicalhub.edu' ||
        request.auth.token.email == 'rudrapartaap37@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Educational Content: Books, Subjects, Chapters
    match /books/{bookId} {
      allow read: if isSignedIn() && (resource.data.isPublished == true || isAdmin());
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn() && (resource.data.isPublished == true || isAdmin());
      allow write: if isAdmin();
    }

    match /chapters/{chapterId} {
      allow read: if isSignedIn() && (resource.data.isPublished == true || isAdmin());
      allow write: if isAdmin();
    }

    match /studyMaterials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /mcqs/{mcqId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /mindMaps/{mapId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Student Progress & Bookmarks & Quiz Attempts
    match /mcqAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /progress/{progressId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
